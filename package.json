{
  "name": "dp-gnosis-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Development workspace for @dp/gnosis — the engine and its benchmark, extracted from AiChatney so the quality gate lives in the same repository as the change it gates.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "gnosis": "tsx packages/gnosis/src/cli/main.ts",
    "gnosis:mcp": "tsx packages/gnosis/src/mcp/main.ts",
    "gnosis:test": "vitest run --config packages/gnosis/vitest.config.ts",
    "gnosis:bench": "./packages/gnosis-bench/bench.sh",
    "gnosis:sweep": "tsx packages/gnosis-bench/src/sweep.ts",
    "gnosis:pair": "tsx packages/gnosis-bench/src/pair.ts",
    "gnosis:charts": "tsx packages/gnosis-bench/src/charts.ts",
    "gnosis:forensics": "tsx packages/gnosis-bench/src/forensicsCli.ts",
    "gnosis:fuseforecast": "tsx packages/gnosis-bench/src/fuseForecastCli.ts",
    "gnosis:goldaudit": "tsx packages/gnosis-bench/src/goldAuditCli.ts",
    "gnosis:enrichgate": "tsx packages/gnosis-bench/src/enrichmentGate.ts",
    "gnosis:vocabgap": "tsx packages/gnosis-bench/src/vocabGapCli.ts",
    "gnosis:detenrich": "tsx packages/gnosis-bench/src/deterministicEnrichment.ts",
    "bench:test": "vitest run --config packages/gnosis-bench/vitest.config.ts",
    "test": "npm run gnosis:test && npm run bench:test",
    "typecheck": "tsc -p packages/gnosis/tsconfig.json --noEmit && tsc -p packages/gnosis-bench/tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  }
}
