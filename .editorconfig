# Matches the repository's ESLint formatter block (eslint.config.mjs):
# 2-space indent, single quotes, semicolons, LF. ESLint remains authoritative
# for TypeScript; this file only stops an editor fighting it before lint runs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown uses trailing whitespace for hard line breaks.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
